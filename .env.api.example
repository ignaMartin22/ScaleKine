# Copiar a .env.api en el servidor (permisos 600). Valores ficticios: nunca poner secretos reales.
# Usuario scalekine_app: sin permisos de estructura ni de borrado (despliegue.md §7).
# Perfil económico: el host es `db`. Perfil administrado: el clúster de DigitalOcean, con ?sslmode=require.
DATABASE_URL=postgresql://scalekine_app:cambiar-clave-app@db:5432/scalekine
ZONA_HORARIA=America/Argentina/Buenos_Aires
PORT=3000
# Origen público: https://<DOMINIO>
FRONTEND_ORIGIN=https://turnos.ejemplo.com.ar
COOKIE_SECURE=true
# 32 bytes en base64 (openssl rand -base64 32). Obligatoria en producción; se respalda fuera del servidor.
CLAVE_CIFRADO=
NODE_ENV=production
LOG_LEVEL=info
