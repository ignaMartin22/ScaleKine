# Copiar a .env y ajustar. Valores ficticios: nunca poner acá secretos reales.

# --- PostgreSQL de desarrollo (docker-compose.yml) ---
POSTGRES_USER=scalekine
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432
# Contraseñas de los usuarios que crea infra/postgres/init/02-usuarios.sh (despliegue.md §7).
# Tienen que coincidir con las de DATABASE_URL y DATABASE_URL_MIGRACIONES.
SCALEKINE_CLAVE_MIGRACIONES=cambiar-clave-migraciones
SCALEKINE_CLAVE_APP=cambiar-clave-app
SCALEKINE_CLAVE_RESPALDO=cambiar-clave-respaldo

# --- Backend (docs/plan.md §5.2) ---
# Usuario de la aplicación: sin permisos de estructura ni de borrado (docs/despliegue.md §7).
DATABASE_URL=postgresql://scalekine_app:cambiar-clave-app@localhost:5432/scalekine_desarrollo
# Solo para aplicar migraciones (dueño del esquema).
DATABASE_URL_MIGRACIONES=postgresql://scalekine_migraciones:cambiar-clave-migraciones@localhost:5432/scalekine_desarrollo
# Base de pruebas de integración: mismos usuarios, otra base. Las pruebas la vacían entre caso y caso.
DATABASE_URL_PRUEBAS=postgresql://scalekine_app:cambiar-clave-app@localhost:5432/scalekine_pruebas
DATABASE_URL_MIGRACIONES_PRUEBAS=postgresql://scalekine_migraciones:cambiar-clave-migraciones@localhost:5432/scalekine_pruebas
# Zona IANA del consultorio (RF-12).
ZONA_HORARIA=America/Argentina/Buenos_Aires
PORT=3000
# Origen del frontend permitido en escrituras y en el handshake de Socket.io.
FRONTEND_ORIGIN=http://localhost:4200
# true en producción: la cookie de sesión viaja solo por HTTPS (RNF-01).
COOKIE_SECURE=false
# Clave de 32 bytes en base64 para cifrar los secretos TOTP (RNF-04). Obligatoria en producción.
# Generar con: openssl rand -base64 32
CLAVE_CIFRADO=
NODE_ENV=development
LOG_LEVEL=info
