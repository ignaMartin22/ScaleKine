# Copiar a .env.db en el servidor (permisos 600). Solo perfil económico (COMPOSE_PROFILES=base-local).
# Valores ficticios: nunca poner secretos reales.
POSTGRES_USER=scalekine
POSTGRES_PASSWORD=cambiar-clave-superusuario
POSTGRES_DB=scalekine
# Las leen infra/postgres/init/02-usuarios.sh al crear el volumen; deben coincidir con las URL de
# .env.api, .env.migraciones y .env.respaldo.
SCALEKINE_CLAVE_MIGRACIONES=cambiar-clave-migraciones
SCALEKINE_CLAVE_APP=cambiar-clave-app
SCALEKINE_CLAVE_RESPALDO=cambiar-clave-respaldo
# En producción hay una sola base y las migraciones no necesitan CREATEDB.
SCALEKINE_BASES=scalekine
SCALEKINE_MIGRACIONES_CREATEDB=false

# Archivo continuo del registro de transacciones con pgBackRest (docs/despliegue.md §8.1).
# Bucket de B2 EU Central PROPIO del registro de transacciones, distinto del de las copias diarias.
# Clave de aplicación limitada a ese bucket (lectura, escritura y listado; en este bucket no hay Object Lock).
PGBACKREST_REPO1_S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
PGBACKREST_REPO1_S3_REGION=eu-central-003
PGBACKREST_REPO1_S3_BUCKET=cambiar-bucket-registro-transacciones
PGBACKREST_REPO1_S3_KEY=cambiar-id-de-clave
PGBACKREST_REPO1_S3_KEY_SECRET=cambiar-clave-de-aplicacion
# Cifra el archivo antes de que salga del servidor. Generar con: openssl rand -base64 48
# Guardarla también en el gestor de contraseñas (§9): sin ella no se puede restaurar.
PGBACKREST_REPO1_CIPHER_PASS=cambiar-por-un-valor-aleatorio-largo
