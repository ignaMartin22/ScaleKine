# Copiar a .env.respaldo en el servidor (permisos 600). Valores ficticios: nunca poner secretos reales.
# Usuario scalekine_respaldo: solo SELECT.
DATABASE_URL_RESPALDO=postgresql://scalekine_respaldo:cambiar-clave-respaldo@db:5432/scalekine
# Clave pública de age (age1...). La privada solo la tiene el administrador.
AGE_DESTINATARIO=age1cambiar-por-la-clave-publica
BUCKET=scalekine-copias
# rclone, remoto `b2` (Backblaze B2, EU Central). Clave de aplicación limitada al bucket de copias, solo con
# `writeFiles`: sin leer, listar ni borrar (infra/README.md, "Buckets de B2").
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=cambiar-id-de-clave
RCLONE_CONFIG_B2_KEY=cambiar-clave-de-aplicacion
# Latido de healthchecks.io: se avisa solo si la copia terminó bien.
LATIDO_URL=https://hc-ping.com/cambiar-uuid
